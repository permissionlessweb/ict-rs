path = "../../terp-rs/tools/svg-mint/e2e/examples/svg_mint_local_prod.rs"
required-features = ["docker", "zakura", "dregg-node", "ethereum", "bitcoin", "svg-mint-product", "hashmarket"]

[[example]]
name = "svg_mint_load_storm"
required-features = ["docker", "zakura", "dregg-node", "ethereum", "bitcoin", "hashmarket"]

[[example]]
name = "svg_mint_base_local"
required-features = ["docker", "ethereum"]

[[example]]
